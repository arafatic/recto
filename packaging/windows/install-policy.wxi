<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Choose scope before launch checks and directory costing. Never move an existing copy. -->
  <!-- Only for me leaves ALLUSERS unset. Publishing ALLUSERS=2 here makes FindRelatedProducts treat the run as
       per-machine and skip the existing per-user copy, so an interactive upgrade installs beside it
       (two registered products, and uninstall leaves files behind). Checked with real msiexec runs. -->
  <Property Id="INSTALLFOLDER" Secure="yes" />
  <Property Id="RECTO_SCOPE" Value="user" Secure="yes" />
  <Property Id="RECTO_U_DIR" Secure="yes"><RegistrySearch Id="RECTO_U_DIRSearch" Root="HKCU" Key="Software\recto" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="RECTO_USER_DIR" Action="RectoUFromDIR" Value="[RECTO_U_DIR]" After="AppSearch" Sequence="both" Condition="NOT RECTO_USER_DIR AND RECTO_U_DIR" />
  <Property Id="RECTO_U_FOLDER" Secure="yes"><RegistrySearch Id="RECTO_U_FOLDERSearch" Root="HKCU" Key="Software\recto" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="RECTO_USER_DIR" Action="RectoUFromFOLDER" Value="[RECTO_U_FOLDER]" After="RectoUFromDIR" Sequence="both" Condition="NOT RECTO_USER_DIR AND RECTO_U_FOLDER" />
  <Property Id="RECTO_U_PATH" Secure="yes"><RegistrySearch Id="RECTO_U_PATHSearch" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\recto.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="RECTO_USER_DIR" Action="RectoUFromPATH" Value="[RECTO_U_PATH]" After="RectoUFromFOLDER" Sequence="both" Condition="NOT RECTO_USER_DIR AND RECTO_U_PATH" />
  <Property Id="RECTO_U_EXEFOLDER" Secure="yes"><RegistrySearch Id="RECTO_ULegacyFolder" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\recto.exe" Type="file" /></Property>
  <Property Id="RECTO_U_EXE" Secure="yes"><RegistrySearch Id="RECTO_ULegacyExe" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\recto.exe" Type="file"><FileSearch Id="RECTO_ULegacyFile" Name="recto.exe" /></RegistrySearch></Property>
  <SetProperty Id="RECTO_USER_DIR" Action="RectoUFromLegacyExe" Value="[RECTO_U_EXEFOLDER]" After="RectoUFromPATH" Sequence="both" Condition="NOT RECTO_USER_DIR AND RECTO_U_EXEFOLDER AND RECTO_U_EXE" />
  <Property Id="RECTO_USER_DIR" Secure="yes" />
  <Property Id="RECTO_M_DIR" Secure="yes"><RegistrySearch Id="RECTO_M_DIRSearch" Root="HKLM" Key="Software\recto" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="RECTO_MACHINE_DIR" Action="RectoMFromDIR" Value="[RECTO_M_DIR]" After="RectoUFromLegacyExe" Sequence="both" Condition="NOT RECTO_MACHINE_DIR AND RECTO_M_DIR" />
  <Property Id="RECTO_M_FOLDER" Secure="yes"><RegistrySearch Id="RECTO_M_FOLDERSearch" Root="HKLM" Key="Software\recto" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="RECTO_MACHINE_DIR" Action="RectoMFromFOLDER" Value="[RECTO_M_FOLDER]" After="RectoMFromDIR" Sequence="both" Condition="NOT RECTO_MACHINE_DIR AND RECTO_M_FOLDER" />
  <Property Id="RECTO_M_PATH" Secure="yes"><RegistrySearch Id="RECTO_M_PATHSearch" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\recto.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="RECTO_MACHINE_DIR" Action="RectoMFromPATH" Value="[RECTO_M_PATH]" After="RectoMFromFOLDER" Sequence="both" Condition="NOT RECTO_MACHINE_DIR AND RECTO_M_PATH" />
  <Property Id="RECTO_M_EXEFOLDER" Secure="yes"><RegistrySearch Id="RECTO_MLegacyFolder" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\recto.exe" Type="file" /></Property>
  <Property Id="RECTO_M_EXE" Secure="yes"><RegistrySearch Id="RECTO_MLegacyExe" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\recto.exe" Type="file"><FileSearch Id="RECTO_MLegacyFile" Name="recto.exe" /></RegistrySearch></Property>
  <SetProperty Id="RECTO_MACHINE_DIR" Action="RectoMFromLegacyExe" Value="[RECTO_M_EXEFOLDER]" After="RectoMFromPATH" Sequence="both" Condition="NOT RECTO_MACHINE_DIR AND RECTO_M_EXEFOLDER AND RECTO_M_EXE" />
  <Property Id="RECTO_MACHINE_DIR" Secure="yes" />
  <SetProperty Id="RECTO_SCOPE" Action="RectoPreferMachineScope" Value="machine" After="RectoMFromLegacyExe" Sequence="ui" Condition="ALLUSERS = 1 OR (RECTO_MACHINE_DIR AND NOT RECTO_USER_DIR)" />
  <SetProperty Id="INSTALLFOLDER" Action="RectoRestoreUserFolder" Value="[RECTO_USER_DIR]" Before="CostInitialize" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1 AND RECTO_USER_DIR" />
  <!-- The wizard can change the context after Windows Installer has already resolved Program Files for the first one.
       Give the new-install folder explicitly so Everyone never lands in the profile and Only for me never lands in Program Files. -->
  <?if $(sys.BUILDARCH) = x86 ?>
  <SetProperty Id="INSTALLFOLDER" Action="RectoDefaultMachineFolder" Value="[%ProgramFiles(x86)]\Recto\" After="RectoRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="RectoDefaultMachineFolder32" Value="[%ProgramFiles]\Recto\" After="RectoDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND NOT VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="RectoDefaultUserFolder" Value="[LocalAppDataFolder]Programs\Recto\" After="RectoDefaultMachineFolder32" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?else?>
  <SetProperty Id="INSTALLFOLDER" Action="RectoDefaultMachineFolder" Value="[%ProgramW6432]\Recto\" After="RectoRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1" />
  <SetProperty Id="INSTALLFOLDER" Action="RectoDefaultUserFolder" Value="[LocalAppDataFolder]Programs\Recto\" After="RectoDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?endif?>
  <SetProperty Id="INSTALLFOLDER" Action="RectoRestoreMachineFolder" Value="[RECTO_MACHINE_DIR]" Before="RectoRestoreUserFolder" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND RECTO_MACHINE_DIR" />
  <Launch Condition="Installed OR ALLUSERS &lt;&gt; 1 OR NOT RECTO_USER_DIR" Message="This app is already installed for your account. Choose Only for me to update it, or uninstall that copy before changing who it is installed for." />
  <Launch Condition="Installed OR ALLUSERS = 1 OR NOT RECTO_MACHINE_DIR" Message="This app is already installed for everyone. Choose Everyone to update it, or pass ALLUSERS=1 to msiexec. Uninstall that copy before changing who it is installed for." />
  <UI>
    <TextStyle Id="RectoScopeText" FaceName="Segoe UI" Size="9" />
    <TextStyle Id="RectoScopeTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
    <Dialog Id="RectoScopeDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\RectoScopeTitle}Who should use [ProductName]?" />
      <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="30" Text="{\RectoScopeText}An update keeps the existing folder. New copies use the Recto folder under Programs." />
      <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="88" Width="330" Height="60" Property="RECTO_SCOPE">
        <RadioButtonGroup Property="RECTO_SCOPE">
          <RadioButton Value="user" X="0" Y="0" Width="330" Height="20" Text="Only for me (no administrator permission needed)" />
          <RadioButton Value="machine" X="0" Y="30" Width="330" Height="20" Text="Everyone on this computer (asks an administrator)" />
        </RadioButtonGroup>
      </Control>
      <Control Id="Next" Type="PushButton" X="214" Y="182" Width="66" Height="20" Default="yes" Text="Next">
        <Publish Property="ALLUSERS" Value="1" Order="1" Condition="RECTO_SCOPE = &quot;machine&quot;" />
        <Publish Property="ALLUSERS" Value="{}" Order="2" Condition="RECTO_SCOPE = &quot;user&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="3" Condition="RECTO_SCOPE = &quot;machine&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="1" Order="4" Condition="RECTO_SCOPE = &quot;user&quot;" />
        <Publish Event="EndDialog" Value="Return" Order="5" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
    </Dialog>
  </UI>
  <InstallUISequence>
    <Show Dialog="RectoScopeDlg" After="RectoPreferMachineScope" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
    <!-- Related-product discovery runs once, so full UI must choose its context first. -->
    <FindRelatedProducts After="RectoScopeDlg" />
  </InstallUISequence>
</Include>
